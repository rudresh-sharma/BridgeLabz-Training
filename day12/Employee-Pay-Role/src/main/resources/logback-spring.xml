<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{25} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling file appender: all logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/employee-payroll.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/employee-payroll-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Error-only file -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/employee-payroll-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/employee-payroll-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================= -->
    <!-- Your app: INFO only. Change to DEBUG manually  -->
    <!-- when you need full LoggingAspect entry/exit    -->
    <!-- tracing - then set back to INFO when done.     -->
    <!-- ============================================= -->
    <logger name="com.employeepayroll" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Kill the giant CONDITIONS EVALUATION REPORT (exact logger name matters) -->
    <logger name="org.springframework.boot.autoconfigure.logging.ConditionEvaluationReportLogger" level="OFF"/>
    <logger name="org.springframework.boot.diagnostics" level="WARN"/>

    <!-- Silence noisy Spring internals: DispatcherServlet request tracing,
         handler-mapping detection, filter registration chatter -->
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.boot" level="WARN"/>

    <!-- Silence Hibernate SQL / bind-parameter tracing -->
    <logger name="org.hibernate" level="WARN"/>

    <!-- Silence Tomcat/Catalina internals -->
    <logger name="org.apache" level="WARN"/>

    <!-- Silence Flyway / Hikari routine chatter (still shows WARN/ERROR) -->
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- DevTools restart/classpath-watch chatter -->
    <logger name="org.springframework.boot.devtools" level="WARN"/>

    <!-- Root: catch-all fallback, quiet -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>